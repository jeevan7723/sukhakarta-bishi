{
  "buildCommand": "",
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/loans", "destination": "/loans.html" },
    { "source": "/members", "destination": "/members.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
